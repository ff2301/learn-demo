{
  "name": "learn-demo",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "pnpm typecheck && vite build",
    "build:pages": "pnpm typecheck && vite build --base=/learn-demo/ && cp dist/index.html dist/404.html",
    "routes:generate": "tsr generate",
    "typecheck": "pnpm routes:generate && tsc -b",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "knip": "knip",
    "check": "pnpm typecheck && pnpm lint && pnpm knip",
    "preview": "vite preview"
  },
  "dependencies": {
    "@tanstack/react-router": "^1.170.10",
    "antd-mobile": "^5.42.3",
    "peerjs": "^1.5.5",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.184.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.16",
    "@tanstack/router-cli": "^1.167.12",
    "@tanstack/router-plugin": "^1.168.13",
    "@types/node": "^24.12.3",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@types/three": "^0.184.1",
    "@vitejs/plugin-react": "^6.0.1",
    "knip": "^6.14.2",
    "typescript": "~6.0.2",
    "vite": "^8.0.12"
  }
}
